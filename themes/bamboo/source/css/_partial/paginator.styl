.page-nav {
  display: flex;
  width: 100%;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;

  // 页码信息始终水平居中(即使第一页没有"上一页"按钮也不会偏移)
  .page-info {
    flex: 1;
    text-align: center;
  }

  .page-nav-pre, .page-nav-next {
    background-color: $color-primary;
    flex: 0 0 auto;
  }

  .page-nav-pre {
    text-align: right;
    border-top-right-radius: 32px;
    border-bottom-right-radius: 32px;
    padding: 10px;
    color: $color-inner;

    .ml-5 {
      margin-left: 5px;
    }
  }

  .page-nav-next {
    text-align: right;
    border-top-left-radius: 32px;
    border-bottom-left-radius: 32px;
    padding: 10px;
    color: $color-inner;

    .mr-5 {
      margin-right: 5px;
    }
  }
}

.w-70 {
  width: 70%;
  margin: 0 auto;

  @media (max-width: 551px) {
    width: 100%;
  }

  @media (max-width: 992px) {
    width: 90%;
  }
}