$sp = 4px

audio,video
  border-radius: 4px
  max-width: 100%
video
  z-index: 1
  trans()
  &:hover
    box-shadow: 0 4px 8px 0px rgba(0, 0, 0, 0.24), 0 8px 16px 0px rgba(0, 0, 0, 0.24)

div.video
  line-height: 0
  text-align: center

div.videos
  max-width: "calc(100% + 2 * %s)" % $sp
  display: flex
  flex-wrap: wrap
  justify-content: flex-start
  align-items: flex-end
  margin: 1em 0 - $sp
  .video,iframe
    width: 100%
    margin: $sp

  iframe
    border-radius: 4px
    width: 100%
    min-height: 300px
  &.left
    justify-content: flex-start
  &.center
    justify-content: center
  &.right
    justify-content: flex-end
  &.stretch
    align-items: stretch
  &[col='1']
    .video,iframe
      width: 100%
  &[col='2']
    .video,iframe
      width: "calc(50% - 2 * %s)" % $sp
  &[col='3']
    .video,iframe
      width: "calc(33.33% - 2 * %s)" % $sp
  &[col='4']
    .video,iframe
      width: "calc(25% - 2 * %s)" % $sp

div.audio
  line-height: 0
  text-align: center
  audio
    width: 100%

div.audios
  max-width: "calc(100% + 2 * %s)" % $sp
  display: flex
  flex-wrap: wrap
  justify-content: flex-start
  align-items: center
  margin: 1em 0 - $sp
  .audio
    width: 100%
    margin: $sp
    audio
      width: 100%
  &.left
    justify-content: flex-start
  &.center
    justify-content: center
  &.right
    justify-content: flex-end
  // 竖排模式: 每首一行
  &.vertical
    flex-direction: column
    align-items: stretch
    .audio
      width: 100%
  &[col='1']
    .audio
      width: 100%
  &[col='2']
    .audio
      width: "calc(50% - 2 * %s)" % $sp
  &[col='3']
    .audio
      width: "calc(33.33% - 2 * %s)" % $sp
  &[col='4']
    .audio
      width: "calc(25% - 2 * %s)" % $sp
  &[col='8']
    .audio
      width: "calc(12.5% - 2 * %s)" % $sp
