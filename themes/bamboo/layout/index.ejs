<% var isFirstPage = (page.current === 1); %>

<!-- 首页轮播(所有分页都保留) -->
<%- partial('_partial/swiper') %>

<div id="l_main">
  <div class="l_content">
    <% if (isFirstPage) { %>
      <!-- 以下为首页专属内容, 仅第一页显示, 翻页后移除 -->
      <%- partial('_partial/notice') %>       <!-- 公告 -->
      <%- partial('_partial/home_widget') %>  <!-- 欢迎 / github 日历等自定义挂件 -->
      <%- partial('_partial/motto') %>        <!-- 座右铭 -->
      <%- partial('_partial/topArticle', {page: page}) %>  <!-- 置顶/推荐文章 -->
    <% } %>

    <div class="bg-floor" id="home-bg-floor" style="position: fixed;left: 0;top: 0;width: 100%;height: 100%;z-index: -2;"></div>

    <!-- 文章卡片列表 + 翻页(所有分页都显示) -->
    <%- partial('_partial/card/post') %>
    <%- partial('_partial/paginator') %>
  </div>

  <!-- 右侧边栏仅第一页显示, 翻页后移除(内容区占满) -->
  <% if (isFirstPage) { %>
    <%- partial('_partial/side') %>
  <% } %>
</div>

<!-- 花瓣和雪花飘落 -->
<%- partial('_partial/scripts/falling') %>
<!-- 灯笼 -->
<%- partial('_partial/lantern') %>
