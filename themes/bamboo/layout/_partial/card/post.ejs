<!-- hash算法 -->
<%
var hashCode = function (str) {
    if (!str && str.length === 0) {
        return 0;
    }

    var hash = 0;
    for (var i = 0, len = str.length; i < len; i++) {
        hash = ((hash << 5) - hash) + str.charCodeAt(i);
        hash |= 0;
    }
    return hash;
};
%>
<section class="posts posts-grid">
  <% page.posts.each(function (post, i) { %>
    <%
      var img = '/medias/defaultImage/1.jpg';
      var imgs = theme.imgs;
      if (imgs && imgs.length > 0) {
        img = imgs[Math.abs(hashCode(post.title) % imgs.length)];
      }
      var cover = post.img || post.swiperImg || img;
      var defImg = url_for('/medias/defaultImage/1.jpg');
      // 概要: 直接截取正文纯文本前 250 字符(舍弃 excerpt)
      var excerptText = strip_html(post.content)
        .replace(/&nbsp;/g, ' ')
        .replace(/&amp;/g, '&')
        .replace(/&lt;/g, '<')
        .replace(/&gt;/g, '>')
        .replace(/&quot;/g, '"')
        .replace(/&#39;/g, "'")
        .replace(/\s+/g, ' ')
        .trim();
      if (excerptText.length > 250) { excerptText = excerptText.substring(0, 250) + '…'; }
    %>
    <article class="post post-card reveal">
      <!-- 上半: 封面图 + 居中标题 -->
      <a class="post-card-cover" href="<%- url_for(post.path) %>"
         style="background-image:url('<%- url_for(cover) %>');">
        <span class="post-card-cover-mask"></span>
        <span class="post-card-title"><%= post.title %></span>
      </a>
      <!-- 下半: 概要 / 时间+分类 / 标签 -->
      <div class="post-card-body">
        <div class="post-card-excerpt">
          <%= excerptText %>
        </div>
        <div class="post-card-meta">
          <span class="post-card-time">
            <i class="fad fa-calendar-alt" aria-hidden="true"></i>
            <%- date(post.date, "YYYY-MM-DD") %>
          </span>
          <span class="post-card-cat">
            <%- partial('_partial/post/categories', {post: post}) %>
          </span>
        </div>
        <div class="post-card-tags">
          <%- partial('_partial/post/tags', {post: post}) %>
        </div>
      </div>
    </article>
  <% }) %>
</section>