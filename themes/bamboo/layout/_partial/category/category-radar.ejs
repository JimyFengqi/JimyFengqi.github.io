<style type="text/css">
    #category-radar {
        width: 100%;
        height: 360px;
    }
</style>

<div class="container" >
    <div class="card" style="padding:10px;background-color: #fff;">
        <div id="category-radar" class="card-content"></div>
    </div>
</div>

<script type="text/javascript" data-pjax>
(function () {
    var el = document.getElementById('category-radar');
    if (!el || typeof echarts === 'undefined') return;

    <%
        var categories = []
        site.categories.map(function(category) {
            categories.push({'name': category.name, 'length': category.length});
        });
        categories.sort((a, b) => {return b.length - a.length});
        // Find the maximum and average values of the post categories.
        var radarValueArr = [];
        categories.some(function(category) {
            radarValueArr.push(category.length);
        });

        var max = Math.max.apply(null, radarValueArr) + Math.min.apply(null, radarValueArr);

        // Calculate the data needed for the radar chart.
        var indicatorArr = [];
        categories.map(function(category) {
            indicatorArr.push({'name': category.name, 'max': max});
        });

        var indicatorData = JSON.stringify(indicatorArr);
        var radarValueData = JSON.stringify(radarValueArr);
    %>

    var option = {
        title: {
            left: 'center',
            text: '<%= __("categoryRadarTitle")  %>',
            textStyle: {
                fontWeight: 500,
                fontSize: 22
            }
        },
        tooltip: {},
        radar: {
            name: {
                textStyle: {
                    color: '#3C4858'
                }
            },
            indicator: <%- indicatorData %>,
            nameGap: 5,
            center: ['50%','55%'],
            radius: '66%'
        },
        series: [{
            type: 'radar',
            color: ['#3ecf8e'],
            areaStyle: {},
            data : [
                {
                    value : <%- radarValueData %>,
                    name : '<%= __("categoryNumber") %>'
                }
            ]
        }]
    };

    // 容器可能被 ScrollReveal/延迟布局影响，等它有实际尺寸再 init，
    // 避免 echarts 在 0x0 容器上初始化导致空白。
    var chart = null;
    function renderRadar() {
        if (el.clientWidth === 0 || el.clientHeight === 0) return false;
        if (!chart) { chart = echarts.init(el); }
        chart.setOption(option);
        chart.resize();
        return true;
    }
    if (!renderRadar()) {
        var tries = 0;
        var timer = setInterval(function () {
            tries++;
            if (renderRadar() || tries > 50) clearInterval(timer);
        }, 100);
    }
    window.addEventListener('resize', function () { if (chart) chart.resize(); });
})();
</script>
